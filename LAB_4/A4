def luhn_validator(card_number):
    # Удаляем пробелы и дефисы, если они есть
    card_number = "".join(card_number.split())
    
    if not card_number.isdigit():
        return False
        
    total_sum = 0
    reverse_digits = card_number[::-1]
    
    for i, digit in enumerate(reverse_digits):
        n = int(digit)
        # Каждую цифру на нечетной позиции (начиная с 1-й с конца, то есть с индекса 0, 2, 4...) оставляем как есть,
        # а на четной (индексы 1, 3, 5...) умножаем на 2.
        if i % 2 == 1:
            n *= 2
            if n > 9:
                n -= 9
        total_sum += n
        
    return total_sum % 10 == 0

if __name__ == "__main__":
    test_card = input("Введите номер кредитной карты для проверки: ")
    if luhn_validator(test_card):
        print("Номер кредитной карты валиден (проверку по алгоритму Луна прошёл).")
    else:
        print("Номер кредитной карты НЕ валиден!")